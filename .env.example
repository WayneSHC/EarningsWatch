# ══════════════════════════════════════════════════════════════════════════════
# EarningsWatch — 環境變數範本
# 複製此檔為 .env 並填入真實 Key（.env 已加入 .gitignore，永遠不進 git）
#
# 進階：用 GCP Secret Manager 統一管理（不必把 key 寫進 .env）
#   1. ./scripts/setup_gcp_secrets.sh           # 把現有 .env 推到 Secret Manager
#   2. 在 .env 只留下：GCP_SECRET_PROJECT=<your-gcp-project-id>
#   3. 應用啟動時會優先從 Secret Manager 抓 :latest 版本；缺漏才退回 env var
# ══════════════════════════════════════════════════════════════════════════════

# ── GCP Secret Manager（選用）────────────────────────────────────────────────
# 設定後，下列所有 *_API_KEY / APP_PASSWORD 會優先從 GCP Secret Manager 抓。
# 沒設或 SDK 未安裝時 → 自動退回讀本檔的值（向下相容）。
GCP_SECRET_PROJECT=                       # 例：earningswatch-demo（留空則停用 Secret Manager）

# ── LLM 後端（至少填一個；自動降級順序：openai → gemini → cohere）────────────
# ⚠ 請填真實 key（不要保留 <your-...-here>）；啟動時會偵測 placeholder 並拒絕
OPENAI_API_KEY=<your-openai-key-here>     # GPT-5 / GPT-5-mini ★ 主力 + Embedding (text-embedding-3-small)
GEMINI_API_KEY=<your-gemini-key-here>     # Gemini 2.5 Flash（免費額度大，主力備援）
COHERE_API_KEY=<your-cohere-key-here>     # Command R+（同時用於 Rerank API）
LLM_BACKEND=                              # 強制指定後端（留空=自動偵測；可填 openai / gemini / cohere）

# ── 即時新聞 ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=<your-tavily-key-here>     # Tavily Search — 專為 LLM Agent 設計

# ── Vector DB ─────────────────────────────────────────────────────────────────
# 本地開發：留空，自動用 localhost:6333（Docker）
# Streamlit Cloud 部署：填入 Qdrant Cloud URL
QDRANT_URL=
QDRANT_API_KEY=                       # 本地不需要；Cloud 模式填入
QDRANT_HOST=localhost                 # 本地模式 host（通常不用改）
QDRANT_PORT=6333                      # 本地模式 port（通常不用改）

# ── LlamaParse（選用）────────────────────────────────────────────────────────
# 僅在 pdfplumber 解析表格失敗時呼叫，免費額度 1000 頁/天
LLAMA_CLOUD_API_KEY=<your-llamacloud-key-here>

# ── 安全設定（對外部署必填）──────────────────────────────────────────────────
# 設定後，進入頁面需先輸入此密碼（啟用簡易存取控制）
# 本機開發可留空（不會顯示密碼輸入框）
APP_PASSWORD=

# ── LLM 進階調校（選用）──────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS=45              # 單一後端呼叫 timeout
# LLM_INJECTION_GUARD=true            # 設 false 停用 prompt injection 防護（測試用）
# LLM_POOL_WORKERS=8                  # 並行 retrieval / news / stock 的 ThreadPoolExecutor 上限
# LLM_PAIR_WORKERS=2                  # contradiction batch_detect 的季度對並行度（每路一個 LLM 呼叫）
# LLM_BUDGET_USD=0.50                 # 單次 query LLM 預算上限（USD），超過會停止 self-reflection retry
# LLM_HYDE_ENABLED=false              # 啟用 HyDE 查詢擴展：embedding 前先讓 LLM 生成假設性回答，提升 recall（每查多 1 次 LLM 呼叫）

# ── LangSmith 追蹤（選用，新版命名）──────────────────────────────────────────
# 設定後每個 LangGraph 節點 / LLM 呼叫會送去 LangSmith dashboard，方便偵錯與
# 觀察 prompt / token 使用。本機 demo 不必開；公開部署或抓回歸時很有用。
# LANGSMITH_TRACING=true              # 必填：true / 1 / yes 任一即啟用
# LANGSMITH_API_KEY=ls__...           # 必填：LangSmith key
# LANGSMITH_PROJECT=earningswatch     # 選填：LangSmith 專案名稱（預設 default）

# ── LangChain 追蹤（舊命名相容；同時設定時 LANGSMITH_* 優先）─────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=earningswatch
