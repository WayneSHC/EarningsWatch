# ══════════════════════════════════════════════════════════════════════════════
# EarningsWatch — 環境變數範本
# 複製此檔為 .env 並填入真實 Key（.env 已加入 .gitignore，永遠不進 git）
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude 3.5 Sonnet — Contradiction Detector

# ── Embedding ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                 # text-embedding-3-small (1536 維)

# ── Retrieval ─────────────────────────────────────────────────────────────────
COHERE_API_KEY=...                    # Rerank API

# ── 即時新聞 ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...               # Tavily Search — 專為 LLM Agent 設計

# ── Vector DB ─────────────────────────────────────────────────────────────────
# 本地開發：留空，自動用 localhost:6333（Docker）
# Streamlit Cloud 部署：填入 Qdrant Cloud URL
QDRANT_URL=
QDRANT_API_KEY=                       # 本地不需要；Cloud 模式填入
QDRANT_HOST=localhost                 # 本地模式 host（通常不用改）
QDRANT_PORT=6333                      # 本地模式 port（通常不用改）

# ── LlamaParse（選用）────────────────────────────────────────────────────────
# 僅在 pdfplumber 解析表格失敗時呼叫，免費額度 1000 頁/天
LLAMA_CLOUD_API_KEY=llx-...

# ── 安全設定（對外部署必填）──────────────────────────────────────────────────
# 設定後，進入頁面需先輸入此密碼（啟用簡易存取控制）
# 本機開發可留空（不會顯示密碼輸入框）
APP_PASSWORD=

# 其他 LLM 後端
GEMINI_API_KEY=                       # Google Gemini（免費 1500次/天，推薦）
GROQ_API_KEY=                         # Llama 3.3 70B（免費高速）
LLM_BACKEND=                          # 強制指定後端（gemini/anthropic/openai/groq/cohere）
