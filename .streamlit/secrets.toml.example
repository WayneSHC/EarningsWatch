# .streamlit/secrets.toml.example
# ══════════════════════════════════════════════════════════════════════════════
# Streamlit Cloud 部署用密鑰範本
# 複製此檔為 secrets.toml 並填入真實 Key（或貼進 Streamlit Cloud 的 Secrets 設定）
# secrets.toml 已加入 .gitignore，永遠不進 git
#
# 注意：
#   1. 所有頂層值必須是「帶引號的字串」。app.py 啟動時只把頂層字串鏡像到
#      os.environ，未加引號的數字（如 LLM_BUDGET_USD = 0.5）會被略過。
#   2. 頂層 key 必須放在 [gcp_service_account] 區塊之前（TOML 語法：表格
#      標頭之後的 key 都屬於該表格）。
# ══════════════════════════════════════════════════════════════════════════════

# ── GCP（BigQuery 向量檢索 + Vertex AI embedding，部署必填）──────────────────
GOOGLE_CLOUD_PROJECT = ""    # GCP 專案 ID；留空則退回下方 SA 金鑰內的 project_id

# ── LLM（至少填一個）─────────────────────────────────────────────────────────
GEMINI_API_KEY = ""          # 推薦：Google AI Studio 免費取得 ★ 主力
OPENAI_API_KEY = ""          # GPT-5 / GPT-5-mini
ANTHROPIC_API_KEY = ""       # Claude Sonnet 4.6 / Haiku 4.5（付費）
COHERE_API_KEY = ""          # Command R+；同時用於 Rerank

# ── LLM 後端切換（選填）──────────────────────────────────────────────────────
LLM_BACKEND = ""             # 留空則自動偵測；可填 gemini/openai/anthropic/cohere

# ── 外部工具（選填）──────────────────────────────────────────────────────────
TAVILY_API_KEY = ""          # 即時新聞搜尋
LLAMA_CLOUD_API_KEY = ""     # LlamaParse 表格補救

# ── 存取控制（建議填入）──────────────────────────────────────────────────────
APP_PASSWORD = ""            # 設定後進入頁面需先輸入密碼

# ── GCP Service Account 金鑰（Streamlit Cloud 必填）─────────────────────────
# Streamlit Cloud 沒有 ADC，bq_client 會直接讀這個表格建構 Credentials。
# 將 GCP 下載的 service-account key JSON 逐欄貼入（private_key 保留 \n）。
# 本機開發不需要此區塊 —— 請整段刪除（會自動走 ADC）；只填一半會啟動失敗。
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
