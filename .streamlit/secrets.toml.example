# .streamlit/secrets.toml.example
# ══════════════════════════════════════════════════════════════════════════════
# Streamlit Cloud 部署用密鑰範本
# 複製此檔為 secrets.toml 並填入真實 Key
# secrets.toml 已加入 .gitignore，永遠不進 git
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM（至少填一個）─────────────────────────────────────────────────────────
GEMINI_API_KEY = ""          # 推薦：Google AI Studio 免費取得
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""
GROQ_API_KEY = ""
COHERE_API_KEY = ""          # 同時用於 Rerank

# ── LLM 後端切換（選填）──────────────────────────────────────────────────────
LLM_BACKEND = ""             # 留空則自動偵測；可填 gemini/anthropic/openai/groq/cohere

# ── Qdrant Cloud（部署必填）──────────────────────────────────────────────────
QDRANT_URL = ""              # e.g. https://xxxx.qdrant.io
QDRANT_API_KEY = ""

# ── 外部工具（選填）──────────────────────────────────────────────────────────
TAVILY_API_KEY = ""          # 即時新聞搜尋
LLAMA_CLOUD_API_KEY = ""     # LlamaParse 表格補救

# ── 存取控制（建議填入）──────────────────────────────────────────────────────
APP_PASSWORD = ""            # 設定後進入頁面需先輸入密碼
